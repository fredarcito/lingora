{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingora",
  "version": "0.1.0",
  "identifier": "com.lingora.app",
  "build": {
    "beforeDevCommand": "sh scripts/fetch-sherpa.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/fetch-sherpa.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lingora",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/espeak-ng"
    ],
    "resources": {
      "resources/espeak-ng-data/": "espeak-ng-data/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "frameworks": [
        "sherpa-libs/libsherpa-onnx-c-api.dylib",
        "sherpa-libs/libonnxruntime.dylib"
      ]
    }
  }
}
